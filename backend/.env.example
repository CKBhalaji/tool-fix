# ToolFix backend configuration template.
# Copy to .env and fill in real values. NEVER commit .env or secrets/.

# --- server ---
TOOLFIX_HOST=0.0.0.0
TOOLFIX_PORT=8080
RUST_LOG=info

# --- database (PostgreSQL only) ---
DATABASE_URL=postgres://toolfix:toolfix@localhost:5432/toolfix

# --- frontend origin (CORS + post-login redirect) ---
FRONTEND_ORIGIN=http://localhost:3000

# --- cookies ---
# Secure=true requires HTTPS; keep false for local development only.
COOKIE_SECURE=false
# SameSite policy: true = Lax, false = None (needs Secure=true).
COOKIE_SAME_SITE=true

# --- ToolFix session tokens ---
# At least 32 characters each. Generate e.g. with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000
JWT_ISSUER=toolfix
JWT_AUDIENCE=toolfix-api

# --- Google OAuth (server-side authorization-code flow) ---
# Path to the downloaded Google Cloud "client secret" JSON file.
# One-time setup: add http://localhost:8080/api/v1/auth/google/callback
# to the client's authorized redirect URIs in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_PATH=./secrets/client_secret_2_549126595676-5j6bdqjrt6lbnltg1ki28q35fr66m4s0.apps.googleusercontent.com.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# --- Firebase (backend-only identity provisioning) ---
FIREBASE_PROJECT_ID=tool-fix
# Firebase Web API key (Project settings -> General). Backend-only value:
# the frontend must never contain Firebase configuration.
FIREBASE_WEB_API_KEY=
# Service account for the Firebase Admin/identity operations.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/tool-fix-firebase-adminsdk-fbsvc-5c013273b0.json
GOOGLE_APPLICATION_CREDENTIALS=./secrets/tool-fix-firebase-adminsdk-fbsvc-5c013273b0.json

# --- agentic layer (AI_PROVIDER = gemini_api | vertex_ai) ---
AI_PROVIDER=gemini_api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash

# --- matching ---
MATCHING_RADIUS_STAGE1_M=3000
MATCHING_RADIUS_STAGE2_M=5000
MATCHING_RADIUS_STAGE3_M=10000
MAX_MECHANICS_NOTIFIED=10
MAX_ACTIVE_JOBS_PER_MECHANIC=3
MATCHING_AVG_SPEED_KMH=25
FEED_LOOKBACK_SECONDS=21600

# --- offers ---
OFFER_EXPIRY_SECONDS=900

# --- storage (local FS backend; metadata lives in PostgreSQL) ---
STORAGE_DIR=./storage
